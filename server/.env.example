PORT=4000
JWT_SECRET=change_this_to_a_random_secret
# Root folder that acts as NAS storage. Point this at your real storage location.
STORAGE_ROOT=D:\Shared

# Optional — email notifications on upload/delete/rename/mkdir/move.
# Notifications are silently disabled unless all four SMTP_* vars and
# NOTIFY_EMAIL_TO are set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
NOTIFY_EMAIL_TO=admin@example.com
